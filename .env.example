# Postgres (backend: transactions, budgets, balances)
POSTGRES_DB=financedash
POSTGRES_USER=financedash
POSTGRES_PASSWORD=financedash
POSTGRES_PORT=5432

# MongoDB (investments service: holdings, pricing)
MONGO_PORT=27017

# RabbitMQ (service <-> backend messaging + intra-service price queue)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Backend
BACKEND_PORT=8080
# Origins allowed to call /api/** (comma-separated, supports * wildcards). The default below covers
# every local setup. IF YOU SERVE THIS ON A REAL DOMAIN, ADD IT HERE — browsers attach an Origin
# header to every POST/PUT/DELETE even same-origin, so an unlisted origin makes all writes fail with
# 403 while the app still loads and reads fine. e.g.:
#   CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://your-domain.example
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*

# Investments service
INVESTMENTS_PORT=8081
# Stock-price provider. Get a free key at https://finnhub.io (60 calls/min).
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Gateway (nginx) — the single origin to open in the browser: http://localhost:8090
GATEWAY_PORT=8090

# Frontend
FRONTEND_PORT=5173
# Left empty so the browser uses relative URLs against the gateway origin (no CORS, one host).
VITE_API_BASE_URL=
